---
lang: pl
title: "Odblokowanie · Panel boczny"
description: "Informacyjny panel z prawej strony — na telefonie dolny arkusz."
crumb: "Szablony · Panel boczny"
altUrl: /en/templates/placements/drawer/
gvm: true
mainClass: "unlock-demo unlock-demo--drawer"
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-drawer.njk" import paymentDrawer %}
{% from "gvm/paywall-drawer.njk" import paywallDrawer %}
{% set article = catalog[lang].article %}

{% block head %}
<link rel="stylesheet" href="/assets/paywalls.css" />
{% endblock %}

{% block content %}
<div class="container">
    <div class="page-head">
        <h1>Panel boczny</h1>
        <p class="lead">Panel z prawej strony wyjaśnia, jak działa odblokowanie SMS-em, i zawiera przycisk płatności. Na telefonie zmienia się w dolny arkusz.</p>
    </div>

    <article class="article">
        <header class="article-head">
            <p class="kicker">Szablony · odblokowanie</p>
            <h1 lang="{{ article.contentLang }}">{{ article.title }}</h1>
            <p class="byline">{{ article.minutes }} min czytania</p>
        </header>

        <div
            id="article"
            class="article-body wait-for-script"
            lang="{{ article.contentLang }}"
            data-gvm-reference="paywall-drawer-{{ lang }}"
            data-gvm-price="1.99"
            data-gvm-template-name="payment"
            data-gvm-hide-template-name="paywall"
            data-gvm-hide-strategy="blur"
            data-gvm-hide-sections="2"
            data-gvm-metadata-title="{{ article.title }}"
            data-gvm-category="article"
        >
            {{ article.html | safe }}
        </div>
    </article>

</div>

{{ paymentDrawer({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{{ paywallDrawer({ t: i18n[lang], termsUrl: site.termsUrl }) }}
{% endblock %}
