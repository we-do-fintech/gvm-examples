---
lang: en
title: High-resolution photo
description: A free preview and a paid full-resolution poster download.
crumb: Publishers · High-resolution photo
altUrl: /publisher/download-hi-res-pic/
gvm: true
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-drawer.njk" import paymentDrawer %}
{% from "gvm/download-trigger.njk" import downloadTrigger %}

{% block content %}
<div class="container">
    <div class="page-head">
        <h1>High-resolution photo</h1>
        <p class="lead">
            The preview is free. The full file is available after a micropayment.
        </p>
    </div>

    <div class="media-grid">
        {% for poster in catalog[lang].posters %}
        <figure class="media-card">
            {% if poster.preview %}
            <img
                src="{{ poster.preview.href }}"
                alt="Preview: poster {{ loop.index }}"
                width="{{ poster.preview.width }}"
                height="{{ poster.preview.height }}"
                loading="lazy"
            />
            {% endif %}
            <figcaption class="media-card__body">
                <h2>Poster {{ loop.index }}</h2>
                <p class="file-meta">
                    {{ poster.full.width }}×{{ poster.full.height }} px · JPG ·
                    {{ poster.full.bytes | filesize }}
                </p>
                {{ downloadTrigger({
                    reference: poster.id,
                    price: "9.00",
                    href: poster.full.href,
                    title: "Poster " ~ loop.index,
                    category: "photo",
                    label: "Download for 9.00 PLN"
                }) }}
            </figcaption>
        </figure>
        {% endfor %}
    </div>
</div>

{{ paymentDrawer({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{% endblock %}
