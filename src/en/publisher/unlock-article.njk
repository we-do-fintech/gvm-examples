---
lang: en
title: Odblokowanie artykułu
description: Bezpłatny początek artykułu i mikropłatność za resztę.
crumb: Wydawcy · Odblokowanie artykułu
altUrl: /publisher/unlock-article/
gvm: true
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-dialog.njk" import paymentDialog %}
{% from "gvm/paywall-inline.njk" import paywallInline %}
{% set article = catalog[lang].article %}

{% extends "layouts/base.njk" %}
{% from "gvm/payment-dialog.njk" import paymentDialog %}
{% from "gvm/paywall-inline.njk" import paywallInline %}
{% set article = catalog[lang].article %}

{% block content %}
<div class="container">
    <article class="article">
        <header class="article-head">
            <p class="kicker">Wydawcy · artykuł</p>
            <h1 lang="{{ article.contentLang }}">{{ article.title }}</h1>
            <p class="byline">{{ article.minutes }} min read</p>
        </header>

        <div
            id="article"
            class="article-body wait-for-script"
            lang="{{ article.contentLang }}"
            data-gvm-reference="artykul-{{ lang }}"
            data-gvm-price="1.99"
            data-gvm-template-name="payment"
            data-gvm-hide-template-name="paywall"
            data-gvm-hide-strategy="hide"
            data-gvm-hide-words="{{ article.previewWords }}"
            data-gvm-metadata-title="{{ article.title }}"
            data-gvm-category="article"
        >
            {{ article.html | safe }}
        </div>

        <footer class="article-source">
            <details>
                <summary>Jak to działa (dla deweloperów)</summary>
                <p>
                    Cały tekst jest w DOM, ale gvm.js ukrywa wszystko po
                    bezpłatnym wstępie ({{ article.previewWords }} słów) i
                    wstrzykuje szablon <code>paywall</code> w miejsce
                    <code>#article</code>. Płatność obsługuje wspólny szablon
                    <code>payment</code>.
                </p>
            </details>
        </footer>
    </article>
</div>

{{ paymentDialog({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{{ paywallInline({ t: i18n[lang], termsUrl: site.termsUrl }) }}
{% endblock %}
