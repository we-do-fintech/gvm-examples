---
lang: en
title: Template — Modal
description: A classic payment dialog in the centre of the screen.
crumb: Templates · Modal
altUrl: /templates/modal/
gvm: true
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-dialog.njk" import paymentDialog %}
{% from "gvm/paywall-inline.njk" import paywallInline %}

{% block content %}
<div class="container">
    <div class="page-head">
        <h1>Modal</h1>
        <p class="lead">A classic dialog in the centre of the screen — good when the form needs to be short.</p>
    </div>

    <div id="demo" class="wait-for-script"
         data-gvm-reference="template-modal"
         data-gvm-price="1.99"
         data-gvm-template-name="payment"
         data-gvm-hide-template-name="paywall"
         data-gvm-hide-strategy="hide"
         data-gvm-hide-words="30"
         data-gvm-metadata-title="Modal template"
         data-gvm-category="article">
        <p>This is sample content. After payment the content is revealed and the form appears exactly as we design it.</p>
        <p>Click the button below to see the dialog.</p>
    </div>
</div>

{{ paymentDialog({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{{ paywallInline({ t: i18n[lang], termsUrl: site.termsUrl, injectTo: "#demo" }) }}
{% endblock %}
