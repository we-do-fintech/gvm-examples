            <ul class="de-cat__list">
                <li><a href="/en/digital-ecommerce/download/#ebook">E-book</a></li>
                <li><a href="/en/digital-ecommerce/download/#report">PDF report</a></li>
                <li><a href="/en/digital-ecommerce/download/#music">Music file</a></li>
                <li><a href="/en/digital-ecommerce/download/#photo">High-resolution photo</a></li>
            </ul>
        </section>
        <section class="de-cat" aria-labelledby="cat-streaming">
            <h3 id="cat-streaming"><a href="/en/digital-ecommerce/streaming/">Streaming</a></h3>
            <p class="de-cat__lede">The content plays right away, with no download.</p>
            <ul class="de-cat__list">
                <li><a href="/en/digital-ecommerce/streaming/#audiobook">Audiobook</a></li>
                <li><a href="/en/digital-ecommerce/streaming/#ppv">Single viewing</a></li>
            </ul>
        </section>
    </div>
</div>
