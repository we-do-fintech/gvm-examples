---
lang: en
title: Music file
description: Single tracks to download after a micropayment.
crumb: Digital commerce · Music file
altUrl: /digital-ecommerce/download-music-file/
gvm: true
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-drawer.njk" import paymentDrawer %}
{% from "gvm/download-trigger.njk" import downloadTrigger %}

{% block content %}
<div class="container">
    <div class="page-head">
        <h1>Music file</h1>
    </div>

    <ul class="track-list">
        {% for track in catalog[lang].music %}
        <li class="track">
            <div>
                <p class="track__name">{{ track.title | capitalize }}</p>
                <p class="track__meta">{{ track.seconds | duration }} · {{ track.bytes | filesize }}</p>
            </div>
            {{ downloadTrigger({
                reference: track.id,
                price: "0.99",
                href: track.href,
                title: track.title,
                category: "music_file",
                label: "Download for 0.99 PLN"
            }) }}
        </li>
        {% endfor %}
    </ul>
</div>

{{ paymentDrawer({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{% endblock %}
