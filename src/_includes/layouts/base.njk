{% set l = i18n[lang] %}
{% set isEn = lang == "en" %}
{% set langPrefix = "/en" if isEn else "" %}
{% set homeUrl = langPrefix + "/" %}
{% set otherLang = "pl" if isEn else "en" %}
{% set otherHref = altUrl if altUrl else ("/" if isEn else "/en/") %}
<!doctype html>
<html lang="{{ lang }}">
    <head>
        {% include "partials/head.njk" %}
        {% block head %}{% endblock %}
    </head>
    <body{% if gvm or gvmLazy %} data-gvm data-gvm-analytics="custom" data-gvm-tenant="{{ site.tenant }}" data-gvm-env="{{ env or site.env }}" data-gvm-currency="{{ site.currency }}"{% endif %}>
        <a class="skip-link" href="#main">{{ l.skipToContent }}</a>
        {% include "partials/header.njk" %}
        {% if crumb %}{% include "partials/example-bar.njk" %}{% endif %}
        <main id="main" class="main{% if mainClass %} {{ mainClass }}{% endif %}">
            {% block content %}{{ content | safe }}{% endblock %}
        </main>
        {% include "partials/footer.njk" %}
        {% if gvm or gvmLazy %}{% include "gvm/dialog-a11y.njk" %}{% endif %}
        <script src="/assets/theme.js" defer></script>
        {% block scripts %}{% endblock %}
    </body>
</html>
