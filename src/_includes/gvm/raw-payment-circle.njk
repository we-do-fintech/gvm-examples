<template
    data-gvm-template="payment"
    data-gvm-template-inject-to="body"
>
    <style>
        /*
         * Design tokens — override on :root (or any ancestor) to re-theme.
         *   fonts    --gvm-font, --gvm-font-mono
         *   text     --gvm-fg, --gvm-fg-2, --gvm-fg-3, --gvm-fg-muted,
         *            --gvm-fg-subtle, --gvm-fg-faint
         *   surface  --gvm-bg, --gvm-bg-subtle, --gvm-bg-muted, --gvm-bg-glass
         *   lines    --gvm-border, --gvm-border-subtle
         *   accent   --gvm-accent, --gvm-accent-fg, --gvm-accent-hover
         *   blocked  --gvm-blocked, --gvm-blocked-hover
         *   effects  --gvm-overlay, --gvm-shadow-color
         *   shape    --gvm-radius, --gvm-radius-pill
         */

        /*
         * Circular payment dialog: the headline rides the top rim as curved
         * SVG text; price, QR, status, consent and actions stack in the
         * middle. The QR stays blurred behind a cover until the consent
         * checkbox is ticked. Shared gvm-payment__* classes keep the themes
         * working.
         */
        .gvm-payment-dialog {
            --gvm-circle-size: min(520px, calc(100vw - 48px));
            --gvm-qr-size: calc(var(--gvm-circle-size) * 0.21);
            --gvm-card-max: var(--gvm-circle-size);

            box-sizing: border-box;

            position: fixed;
            inset: 0;
            z-index: 1000001;

            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
            max-width: none;
            height: auto;
            max-height: none;

            margin: 0;
            padding: 20px;
            padding:
                max(20px, env(safe-area-inset-top))
                max(20px, env(safe-area-inset-right))
                max(20px, env(safe-area-inset-bottom))
                max(20px, env(safe-area-inset-left));

            border: 0;
            border-radius: 0;

            background: var(--gvm-overlay, rgba(0, 0, 0, 0.6));
            color: var(--gvm-fg, #111);

            -webkit-backdrop-filter: blur(4px);
            backdrop-filter: blur(4px);

            overflow: auto;
            overscroll-behavior: contain;
            -webkit-overflow-scrolling: touch;
        }

        .gvm-payment-dialog::backdrop {
            background: var(--gvm-overlay, rgba(0, 0, 0, 0.6));
        }

        .gvm-payment,
        .gvm-payment * {
            box-sizing: border-box;
        }

        .gvm-payment {
            position: relative;

            width: 100%;
            max-width: var(--gvm-card-max);

            margin: auto;
            padding: 28px 24px 22px;

            background: var(--gvm-bg, #fff);
            color: var(--gvm-fg, #111);

            border: 1px solid var(--gvm-border, #d8d8d8);
            border-radius: var(--gvm-radius, 14px);

            box-shadow: 0 20px 60px var(--gvm-shadow-color, rgba(0, 0, 0, 0.2));

            text-align: center;

            font-family: var(--gvm-font, system-ui, -apple-system,
                BlinkMacSystemFont, "Segoe UI", sans-serif);
        }

        /*
         * The circle is a centred column: price, QR, status, consent and
         * actions stack in the middle, padded so nothing touches the rim.
         */
        .gvm-payment--circle {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 7px;

            width: var(--gvm-circle-size);
            height: var(--gvm-circle-size);
            max-width: none;

            padding: 14% 9% 8%;

            border-radius: 50%;

            overflow: hidden;
        }

        .gvm-payment-circle__arc {
            position: absolute;
            inset: 0;

            width: 100%;
            height: 100%;

            pointer-events: none;
        }

        .gvm-payment-circle__arc text {
            fill: var(--gvm-fg-subtle, #777);

            font-family: var(--gvm-font, system-ui, -apple-system,
                BlinkMacSystemFont, "Segoe UI", sans-serif);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2.5px;
        }

        .gvm-payment__close {
            position: absolute;
            top: 12%;
            right: 12%;
            z-index: 3;

            display: flex;
            align-items: center;
            justify-content: center;

            width: 30px;
            height: 30px;

            padding: 0;

            background: transparent;
            color: var(--gvm-fg-subtle, #999);

            border: 0;
            border-radius: var(--gvm-radius-pill, 999px);

            font-family: inherit;
            font-size: 19px;
            line-height: 1;

            cursor: pointer;
        }

        .gvm-payment__close:hover {
            background: var(--gvm-bg-muted, #f5f5f5);
            color: var(--gvm-fg, #111);
        }

        .gvm-payment__close:focus-visible {
            outline: 2px solid var(--gvm-accent, #111);
            outline-offset: 2px;
        }

        /* QR gate — centre of the column, blurred until consent is given */
        .gvm-payment__qr-gate {
            position: relative;
            z-index: 1;

            flex: 0 0 auto;

            width: var(--gvm-qr-size);
            height: var(--gvm-qr-size);
        }

        .gvm-payment__qr {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
            height: 100%;

            background: var(--gvm-bg, #fff);
            border: 1px solid var(--gvm-border, #ddd);
            border-radius: var(--gvm-radius, 4px);

            overflow: hidden;

            transition: filter 0.2s ease;
        }

        .gvm-payment__qr > * {
            max-width: 100%;
            max-height: 100%;
        }

        .gvm-payment__qr img {
            display: block;

            width: 100%;
            height: 100%;

            object-fit: contain;
        }

        .gvm-payment__qr [aria-busy="true"] {
            width: 25px;
            height: 25px;

            border: 2px solid var(--gvm-border, #ddd);
            border-top-color: var(--gvm-accent, #111);
            border-radius: 50%;

            animation: gvm-payment-spin 0.8s linear infinite;
        }

        @keyframes gvm-payment-spin {
            to {
                transform: rotate(360deg);
            }
        }

        .gvm-payment__qr-gate.gvm-terms-blocked .gvm-payment__qr {
            filter: blur(10px);
        }

        .gvm-payment__qr-cover {
            display: none;

            position: absolute;
            inset: 0;
            z-index: 2;

            align-items: center;
            justify-content: center;

            padding: 10px;

            background: var(--gvm-bg-glass, rgba(255, 255, 255, 0.86));

            color: var(--gvm-fg, #111);

            font-size: 11px;
            line-height: 1.35;
            font-weight: 600;
            text-align: center;
        }

        .gvm-payment__qr-gate.gvm-terms-blocked .gvm-payment__qr-cover {
            display: flex;
        }

        /* headline for the mobile card fallback (the arc carries it on desktop) */
        .gvm-payment__lead {
            display: none;

            margin: 0;
            padding: 0 10px;

            color: var(--gvm-fg, #111);

            font-size: 16px;
            line-height: 1.3;
            font-weight: 600;
        }

        .gvm-payment__price {
            margin: 0;

            color: var(--gvm-fg, #111);

            font-size: 18px;
            font-weight: 700;
            line-height: 1.1;
        }

        .gvm-payment__status {
            width: 62%;
            margin: 0;

            color: var(--gvm-fg-subtle, #777);

            font-size: 11.5px;
            line-height: 1.3;
        }

        .gvm-payment__time {
            white-space: nowrap;
        }

        /*
         * Consent (regulamin §4.2 info + §11.2 checkbox) — between status and
         * actions, never hidden (on phones it gates the SMS button).
         */
        .gvm-payment__info {
            width: 100%;
            margin: 2px 0 0;

            color: var(--gvm-fg-muted, #666);

            font-size: 11px;
            line-height: 1.4;
        }

        .gvm-payment__info a,
        .gvm-payment__terms a {
            color: var(--gvm-fg, #111);
            text-decoration: underline;
        }

        .gvm-payment__terms {
            display: flex;
            align-items: flex-start;
            gap: 7px;

            width: 100%;
            margin: 0;

            color: var(--gvm-fg-3, #444);

            font-size: 11px;
            line-height: 1.4;
            text-align: left;

            cursor: pointer;
        }

        .gvm-payment__terms input {
            flex: 0 0 auto;

            width: 15px;
            height: 15px;

            margin: 1px 0 0;

            accent-color: var(--gvm-accent, #111);
        }

        .gvm-payment__terms input.gvm-terms-invalid {
            outline: 2px solid var(--gvm-danger, #c62828);
            outline-offset: 2px;
        }

        .gvm-payment__actions {
            display: flex;
            gap: 8px;

            width: 60%;
            margin-top: 3px;
        }

        .gvm-payment__actions button {
            flex: 1 1 0;

            min-height: 40px;

            margin: 0;
            padding: 9px 10px;

            border-radius: var(--gvm-radius, 4px);

            font-family: inherit;
            font-size: 12.5px;
            font-weight: 600;

            cursor: pointer;
        }

        .gvm-payment__actions button:focus-visible {
            outline: 2px solid var(--gvm-accent, #111);
            outline-offset: 2px;
        }

        .gvm-payment__send {
            background: var(--gvm-accent, #111);
            color: var(--gvm-accent-fg, #fff);
            border: 1px solid var(--gvm-accent, #111);
        }

        .gvm-payment__send:hover {
            background: var(--gvm-accent-hover, #333);
            border-color: var(--gvm-accent-hover, #333);
        }

        .gvm-payment__send.gvm-terms-blocked {
            background: var(--gvm-blocked, #777);
            border-color: var(--gvm-blocked, #777);

            cursor: not-allowed;
        }

        .gvm-payment__send.gvm-terms-blocked:hover {
            background: var(--gvm-blocked-hover, #666);
            border-color: var(--gvm-blocked-hover, #666);
        }

        .gvm-payment__cancel {
            background: var(--gvm-bg, #fff);
            color: var(--gvm-fg-2, #333);
            border: 1px solid var(--gvm-border, #d5d5d5);
        }

        .gvm-payment__cancel:hover {
            background: var(--gvm-bg-muted, #f5f5f5);
        }

        /*
         * Below 580px the circle has no room left: fall back to a clean card
         * (the arc is replaced by a normal headline).
         */
        @media (max-width: 580px) {
            .gvm-payment-dialog {
                --gvm-card-max: 360px;
                --gvm-qr-size: min(170px, 45vw);

                padding: 10px;
            }

            .gvm-payment--circle {
                gap: 12px;

                width: 100%;
                height: auto;
                max-width: var(--gvm-card-max);

                padding: 26px 22px 22px;

                border-radius: var(--gvm-radius, 14px);
            }

            .gvm-payment-circle__arc {
                display: none;
            }

            .gvm-payment__lead {
                display: block;
            }

            .gvm-payment__status,
            .gvm-payment__actions {
                width: 100%;
            }

            .gvm-payment__info,
            .gvm-payment__terms {
                font-size: 12px;
            }

            /* a phone cannot scan its own screen — SMS is the action */
            .gvm-payment__qr,
            .gvm-payment__qr-gate {
                display: none;
            }

            .gvm-payment__close {
                top: 8px;
                right: 8px;
            }

            .gvm-payment__actions {
                display: grid;
                gap: 8px;
                margin-top: 0;
            }

            .gvm-payment__actions button {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .gvm-payment__qr [aria-busy="true"] {
                animation: none;
            }

            .gvm-payment__qr {
                transition: none;
            }
        }
    </style>

    <dialog
        open
        class="gvm-payment-dialog gvm-payment-dialog--circle"
        aria-label="Potwierdź SMS-em, aby odblokować treść"
    >
        <article class="gvm-payment gvm-payment--circle">
            <svg
                class="gvm-payment-circle__arc"
                viewBox="0 0 360 360"
                aria-hidden="true"
                focusable="false"
            >
                <defs>
                    <path
                        id="gvm-payment-circle-arc"
                        d="M 48 180 A 132 132 0 0 1 312 180"
                        fill="none"
                    />
                </defs>
                <text>
                    <textPath
                        href="#gvm-payment-circle-arc"
                        startOffset="50%"
                        text-anchor="middle"
                    >
                        ZESKANUJ LUB WYŚLIJ SMS
                    </textPath>
                </text>
            </svg>

            <button
                type="button"
                class="gvm-payment__close"
                data-gvm-bind-cancel
                aria-label="Zamknij"
            >
                ×
            </button>

            <p class="gvm-payment__lead">
                Wyślij SMS, aby odblokować treść
            </p>

            <p class="gvm-payment__price">
                <span data-gvm-bind-price></span>
                <span data-gvm-bind-currency></span>
            </p>

            <div
                class="gvm-payment__qr-gate gvm-terms-blocked"
                data-gvm-terms-container
            >
                <div
                    data-gvm-bind-qr
                    class="gvm-payment__qr"
                >
                    <span aria-busy="true"></span>
                </div>

                <div class="gvm-payment__qr-cover">
                    Zaznacz zgodę poniżej, aby wyświetlić kod QR.
                </div>
            </div>

            <p class="gvm-payment__status">
                <span
                    data-gvm-bind-status
                    data-gvm-bind-status-initializing="Przygotowywanie kodu QR…"
                    data-gvm-bind-status-waiting="Oczekiwanie na wiadomość SMS…"
                    data-gvm-bind-status-duplicated="Ten numer ma już odblokowany materiał."
                    data-gvm-bind-status-resolved="Płatność potwierdzona. Odblokowujemy materiał…"
                    data-gvm-bind-status-rejected="Nie udało się potwierdzić płatności. Spróbuj ponownie."
                ></span>

                <span class="gvm-payment__time">
                    (
                    <span data-gvm-bind-time-remaining>
                        00:00
                    </span>
                    )
                </span>
            </p>

            <p class="gvm-payment__info">
                Dostęp do tej Treści jest odpłatny:
                <strong><span data-gvm-bind-price></span>&nbsp;<span data-gvm-bind-currency></span></strong>
                zostanie doliczone do zbiorczego rozliczenia Twojej Sesji.
                Sublicencja do Treści wygasa z chwilą Płatności. Szczegóły w
                <a href="https://getviamsg.com/terms" target="_blank" rel="noopener">Regulaminie</a>.
            </p>

            <label class="gvm-payment__terms">
                <input
                    type="checkbox"
                    data-gvm-accept-terms=".gvm-payment__qr-gate, [data-gvm-bind-send-sms]"
                    data-gvm-accept-terms-version="pl-2026-10-23"
                    data-gvm-accept-terms-label="Zaznacz zgodę, aby kontynuować"
                />
                <span>Żądam rozpoczęcia świadczenia przed upływem terminu do odstąpienia od umowy i przyjmuję do wiadomości, że z chwilą udostępnienia Treści tracę prawo odstąpienia od umowy.</span>
            </label>

            <div class="gvm-payment__actions">
                <button
                    type="button"
                    class="gvm-payment__send"
                    data-gvm-bind-send-sms
                >
                    Wyślij SMS
                </button>

                <button
                    type="button"
                    class="gvm-payment__cancel"
                    data-gvm-bind-cancel
                >
                    Anuluj
                </button>
            </div>
        </article>
    </dialog>
</template>