{#
  Circular payment dialog for Templates → Circle (raw variant).

    {% from "gvm/raw-payment-circle.njk" import paymentCircle %}
    {{ paymentCircle({ t: i18n[lang], termsUrl: site.termsUrl,
                       termsVersion: site.termsVersion }) }}

  Imports are isolated from the render context, so `t` and the terms data
  are passed in explicitly. All visible copy comes from `t`.
#}
{% macro paymentCircle(opts) %}
{% set t = opts.t %}
{% set s = t.consent.subjects[opts.subject] or t.consent.subjects.content %}
<template
    data-gvm-template="payment"
    data-gvm-template-inject-to="body"
>
    <style>
        /*
         * Design tokens — override on :root (or any ancestor) to re-theme.
         *   fonts    --gvm-font, --gvm-font-mono
         *   text     --gvm-fg, --gvm-fg-2, --gvm-fg-3, --gvm-fg-muted,
         *            --gvm-fg-subtle, --gvm-fg-faint
         *   surface  --gvm-bg, --gvm-bg-subtle, --gvm-bg-muted, --gvm-bg-glass
         *   lines    --gvm-border, --gvm-border-subtle
         *   accent   --gvm-accent, --gvm-accent-fg, --gvm-accent-hover
         *   blocked  --gvm-blocked, --gvm-blocked-hover
         *   effects  --gvm-overlay, --gvm-shadow-color
         *   shape    --gvm-radius, --gvm-radius-pill
         */

        /*
         * Circular payment dialog, two stacked blocks:
         *
         *   1. the round medallion — the arc headline on the rim, the price and
         *      the QR gate;
         *   2. the panel below — the status line, the §4.2 consent info, the
         *      §11.2 checkbox and the single action.
         *
         * A circle only inscribes a square of ~70% of its diameter, so the long
         * consent copy can never sit inside the rim without being clipped. The
         * medallion carries the identity, the panel carries the reading copy.
         */
        .gvm-payment-dialog {
            --gvm-card-max: min(26rem, calc(100vw - 48px));
            --gvm-circle-size: var(--gvm-card-max);
            --gvm-qr-size: calc(var(--gvm-circle-size) * 0.46);

            box-sizing: border-box;

            position: fixed;
            inset: 0;
            z-index: 1000001;

            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
            max-width: none;
            height: auto;
            max-height: none;

            margin: 0;
            padding: 20px;
            padding:
                max(20px, env(safe-area-inset-top))
                max(20px, env(safe-area-inset-right))
                max(20px, env(safe-area-inset-bottom))
                max(20px, env(safe-area-inset-left));

            border: 0;
            border-radius: 0;

            background: var(--gvm-overlay, rgba(0, 0, 0, 0.6));
            color: var(--gvm-fg, #111);

            -webkit-backdrop-filter: blur(4px);
            backdrop-filter: blur(4px);

            overflow: auto;
            overscroll-behavior: contain;
            -webkit-overflow-scrolling: touch;
        }

        .gvm-payment-dialog::backdrop {
            background: var(--gvm-overlay, rgba(0, 0, 0, 0.6));
        }

        .gvm-payment,
        .gvm-payment * {
            box-sizing: border-box;
        }

        /*
         * Transparent column: the medallion and the panel carry their own
         * surface, so the pair reads as one component instead of a card.
         */
        .gvm-payment {
            position: relative;

            display: flex;
            flex-direction: column;
            align-items: center;

            width: 100%;
            max-width: var(--gvm-card-max);

            margin: auto;
            padding: 0;

            background: transparent;
            color: var(--gvm-fg, #111);

            border: 0;
            border-radius: var(--gvm-radius, 14px);
            box-shadow: none;

            text-align: center;

            font-family: var(--gvm-font, system-ui, -apple-system,
                BlinkMacSystemFont, "Segoe UI", sans-serif);
        }

        /* --- 1. the round medallion ------------------------------------- */
        .gvm-payment__circle {
            position: relative;

            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;

            width: min(var(--gvm-circle-size), 100%);
            aspect-ratio: 1 / 1;

            /* the top inset keeps the price clear of the arc headline */
            padding: 27% 10% 7%;

            background: var(--gvm-bg, #fff);
            border: 1px solid var(--gvm-border, #d8d8d8);
            border-radius: 50%;

            box-shadow: 0 20px 60px var(--gvm-shadow-color, rgba(0, 0, 0, 0.2));

            overflow: hidden;
        }

        .gvm-payment-circle__arc {
            position: absolute;
            inset: 0;

            width: 100%;
            height: 100%;

            pointer-events: none;
        }

        .gvm-payment-circle__arc text {
            fill: var(--gvm-fg-subtle, #777);

            font-family: var(--gvm-font, system-ui, -apple-system,
                BlinkMacSystemFont, "Segoe UI", sans-serif);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2.5px;
        }

        /* --- 2. the panel attached below -------------------------------- */
        .gvm-payment__panel {
            display: flex;
            flex-direction: column;
            gap: 0.7rem;

            width: 100%;
            margin-top: 0.65rem;
            padding: 1.5rem 1.4rem 1.4rem;

            background: var(--gvm-bg, #fff);
            border: 1px solid var(--gvm-border, #d8d8d8);
            border-radius: var(--gvm-radius, 14px);

            box-shadow: 0 20px 60px var(--gvm-shadow-color, rgba(0, 0, 0, 0.2));

            text-align: left;
        }

        /*
         * Round cancel. It rides the medallion's upper-right, so it is placed
         * from the circle's centre: on desktop the medallion is the full dialog
         * width, on phones it is a centred badge.
         */
        .gvm-payment__close {
            position: absolute;
            z-index: 3;

            top: calc(var(--gvm-circle-size) * 0.24);
            right: calc(50% - var(--gvm-circle-size) * 0.41);

            display: inline-flex;
            align-items: center;
            justify-content: center;

            width: 2.25rem;
            height: 2.25rem;

            padding: 0;

            background: transparent;
            color: var(--gvm-fg-muted, #666);

            border: 1px solid var(--gvm-border, #ddd);
            border-radius: 50%;

            font-family: inherit;
            font-size: 18px;
            line-height: 1;

            cursor: pointer;
        }

        .gvm-payment__close:hover {
            background: var(--gvm-bg-muted, #f5f5f5);
            color: var(--gvm-fg, #111);
            border-color: var(--gvm-fg-subtle, #999);
        }

        .gvm-payment__close:focus-visible {
            outline: 2px solid var(--gvm-accent, #111);
            outline-offset: 2px;
        }

        /* QR gate — centre of the medallion, blurred until consent is given */
        .gvm-payment__qr-gate {
            position: relative;
            z-index: 1;

            flex: 0 0 auto;

            width: var(--gvm-qr-size);
            height: var(--gvm-qr-size);
        }

        .gvm-payment__qr {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
            height: 100%;

            /* a QR needs a light quiet zone in both themes */
            background: var(--qr-bg, #fff);
            border: 1px solid var(--gvm-border, #ddd);
            border-radius: var(--gvm-radius, 4px);

            overflow: hidden;

            transition: filter 0.2s ease;
        }

        .gvm-payment__qr > * {
            max-width: 100%;
            max-height: 100%;
        }

        .gvm-payment__qr img {
            display: block;

            width: 100%;
            height: 100%;

            object-fit: contain;
        }

        .gvm-payment__qr [aria-busy="true"] {
            width: 25px;
            height: 25px;

            border: 2px solid var(--gvm-border, #ddd);
            border-top-color: var(--gvm-accent, #111);
            border-radius: 50%;

            animation: gvm-payment-spin 0.8s linear infinite;
        }

        @keyframes gvm-payment-spin {
            to {
                transform: rotate(360deg);
            }
        }

        .gvm-payment__qr-gate.gvm-terms-blocked .gvm-payment__qr {
            filter: blur(10px);
        }

        .gvm-payment__qr-cover {
            display: none;

            position: absolute;
            inset: 0;
            z-index: 2;

            align-items: center;
            justify-content: center;

            padding: 10px;

            background: var(--qr-veil, rgba(255, 255, 255, 0.92));

            color: var(--qr-ink, #444);

            font-size: var(--fs-xs, 0.78rem);
            line-height: 1.4;
            font-weight: 600;
            text-align: center;
        }

        .gvm-payment__qr-gate.gvm-terms-blocked .gvm-payment__qr-cover {
            display: flex;
        }

        /* the headline for the mobile badge (the arc carries it on desktop) */
        .gvm-payment__lead {
            display: none;

            margin: 0;

            color: var(--gvm-fg, #111);

            font-size: var(--fs-lg, 1.125rem);
            line-height: 1.3;
            font-weight: 600;
            text-wrap: pretty;
        }

        .gvm-payment__price {
            margin: 0;

            color: var(--gvm-fg, #111);

            font-size: var(--fs-lg, 1.125rem);
            font-weight: 700;
            line-height: 1.1;
        }

        .gvm-payment__status {
            margin: 0;

            color: var(--gvm-fg-muted, #666);

            font-size: var(--fs-xs, 0.78rem);
            line-height: 1.4;
        }

        .gvm-payment__time {
            white-space: nowrap;
        }

        /*
         * Consent (regulamin §4.2 info + §11.2 checkbox) — the reading copy of
         * the panel, left-aligned and never hidden.
         */
        .gvm-payment__info {
            margin: 0;

            color: var(--gvm-fg-muted, #666);

            font-size: var(--fs-xs, 0.78rem);
            line-height: 1.5;
            text-align: left;
            text-wrap: pretty;
        }

        .gvm-payment__info a,
        .gvm-payment__terms a {
            color: var(--gvm-fg, #111);
            text-decoration: underline;
        }

        .gvm-payment__terms {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;

            margin: 0;

            color: var(--gvm-fg-3, #444);

            font-size: var(--fs-xs, 0.78rem);
            line-height: 1.45;
            text-align: left;
            text-wrap: pretty;

            cursor: pointer;
        }

        .gvm-payment__terms input {
            flex: 0 0 auto;

            width: 16px;
            height: 16px;

            margin: 1px 0 0;

            accent-color: var(--gvm-accent, #111);
        }

        .gvm-payment__terms input.gvm-terms-invalid {
            outline: 2px solid var(--gvm-danger, #c62828);
            outline-offset: 2px;
        }

        .gvm-payment__actions {
            display: grid;
            gap: 0.5rem;

            width: 100%;
            margin-top: 0.15rem;
        }

        .gvm-payment__actions button {
            width: 100%;
            min-height: 2.75rem;

            margin: 0;
            padding: 0.625rem 0.875rem;

            border-radius: var(--radius, 12px);

            font-family: inherit;
            font-size: var(--fs-sm, 0.875rem);
            font-weight: 600;

            cursor: pointer;
        }

        .gvm-payment__actions button:focus-visible {
            outline: 2px solid var(--gvm-accent, #111);
            outline-offset: 2px;
        }

        .gvm-payment__send {
            background: var(--gvm-accent, #111);
            color: var(--gvm-accent-fg, #fff);
            border: 1px solid var(--gvm-accent, #111);
        }

        .gvm-payment__send:hover {
            background: var(--gvm-accent-hover, #333);
            border-color: var(--gvm-accent-hover, #333);
        }

        .gvm-payment__send.gvm-terms-blocked {
            background: var(--gvm-blocked, #777);
            border-color: var(--gvm-blocked, #777);

            cursor: not-allowed;
        }

        .gvm-payment__send.gvm-terms-blocked:hover {
            background: var(--gvm-blocked-hover, #666);
            border-color: var(--gvm-blocked-hover, #666);
        }

        /*
         * Below 720px there is no room for the rim: the medallion shrinks to a
         * round price badge, the arc and the QR go (a phone cannot scan its own
         * screen) and the panel becomes the whole reading card.
         */
        @media (max-width: 720px) {
            .gvm-payment-dialog {
                --gvm-card-max: min(26rem, 100%);
                --gvm-circle-size: min(11rem, 52vw);

                padding: 10px;
            }

            .gvm-payment__circle {
                gap: 0.35rem;
                padding: 18% 8% 8%;
            }

            .gvm-payment-circle__arc {
                display: none;
            }

            .gvm-payment__lead {
                display: block;
            }

            .gvm-payment__qr,
            .gvm-payment__qr-gate {
                display: none;
            }

            .gvm-payment__panel {
                margin-top: 0.55rem;
                padding: 1.4rem 1.25rem 1.25rem;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .gvm-payment__qr [aria-busy="true"] {
                animation: none;
            }

            .gvm-payment__qr {
                transition: none;
            }
        }
    </style>

    <dialog
        open
        class="gvm-payment-dialog gvm-payment-dialog--circle"
        aria-label="{{ t.payment.heading }}"
    >
        <article class="gvm-payment gvm-payment--circle">
            <div class="gvm-payment__circle">
                <svg
                    class="gvm-payment-circle__arc"
                    viewBox="0 0 360 360"
                    aria-hidden="true"
                    focusable="false"
                >
                    <defs>
                        <path
                            id="gvm-payment-circle-arc"
                            d="M 48 180 A 132 132 0 0 1 312 180"
                            fill="none"
                        />
                    </defs>
                    <text>
                        <textPath
                            href="#gvm-payment-circle-arc"
                            startOffset="50%"
                            text-anchor="middle"
                        >
                            {{ t.payment.circleArc }}
                        </textPath>
                    </text>
                </svg>

                <p class="gvm-payment__price">
                    <span data-gvm-bind-price></span>
                    <span data-gvm-bind-currency></span>
                </p>

                <div
                    class="gvm-payment__qr-gate gvm-terms-blocked"
                    data-gvm-terms-container
                >
                    <div
                        data-gvm-bind-qr
                        class="gvm-payment__qr"
                    >
                        <span aria-busy="true"></span>
                    </div>

                    <div class="gvm-payment__qr-cover">
                        {{ t.payment.qrHint }}
                    </div>
                </div>
            </div>

            <div class="gvm-payment__panel">
                <p class="gvm-payment__lead">
                    {{ t.payment.circleLead }}
                </p>

                <p class="gvm-payment__status">
                    <span
                        data-gvm-bind-status
                        data-gvm-bind-status-initializing="{{ t.payment.statusInitializing }}"
                        data-gvm-bind-status-waiting="{{ t.payment.statusWaiting }}"
                        data-gvm-bind-status-duplicated="{{ t.payment.statusDuplicated }}"
                        data-gvm-bind-status-resolved="{{ t.payment.statusResolved }}"
                        data-gvm-bind-status-rejected="{{ t.payment.statusRejected }}"
                    ></span>

                    <span class="gvm-payment__time">
                        (
                        <span data-gvm-bind-time-remaining>
                            00:00
                        </span>
                        )
                    </span>
                </p>

                <p class="gvm-payment__info" lang="{{ t.consent.lang }}">
                    {{ s.before }}
                    <strong><span data-gvm-bind-price></span>&nbsp;<span data-gvm-bind-currency></span></strong>
                    {{ s.after }}
                    <a href="{{ opts.termsUrl }}" target="_blank" rel="noopener">{{ t.consent.terms }}</a>.
                </p>

                <label class="gvm-payment__terms">
                    <input
                        type="checkbox"
                        data-gvm-accept-terms=".gvm-payment__qr-gate, [data-gvm-bind-send-sms]"
                        data-gvm-accept-terms-version="{{ opts.termsVersion }}"
                        data-gvm-accept-terms-label="{{ t.payment.consentLabel }}"
                    />
                    <span lang="{{ t.consent.lang }}">{{ t.consent.legal }}</span>
                </label>

                <div class="gvm-payment__actions">
                    <button
                        type="button"
                        class="gvm-payment__send"
                        data-gvm-bind-send-sms
                    >
                        {{ t.payment.sendSms }}
                    </button>
                </div>
            </div>

            {#  Cancel is the round × on the rim, kept last in the DOM so the
                consent checkbox keeps the first tab stop. #}
            <button
                type="button"
                class="gvm-payment__close"
                data-gvm-bind-cancel
                aria-label="{{ t.payment.close }}"
            >
                <span aria-hidden="true">×</span>
            </button>
        </article>
    </dialog>
</template>
{% endmacro %}
