{#
  Brand lockup. Uses the real logotype instead of the words "GetViaMsg" — a
  wordmark set in text always drifts from the brand.

  Two flavours, both theme-aware (the light/dark swap reuses the same classes as
  the site bar, see assets/theme.css):
    - plain mono lockup  — the site bar and the payment surfaces;
    - "GetViaMsg by WDFT" — the site footer, where there is room for the full
      lockup. `gvmBrand({ lockup: true })`.
#}
{% macro gvmBrand(opts) %}
{% set o = opts or {} %}
<a class="gvm-brand {{ o.classes or '' }}" href="https://getviamsg.com/" rel="noopener">
    {% if o.lockup %}
    <img
        class="brand-logo brand-logo--lockup brand__logo--dark"
        src="/assets/getviamsg-logo-white-t-wdft.png"
        alt="GetViaMsg by WDFT"
        width="400"
        height="120"
    />
    <img
        class="brand-logo brand-logo--lockup brand__logo--light"
        src="/assets/getviamsg-logo-dark-t-logo-wdft.png"
        alt=""
        aria-hidden="true"
        width="400"
        height="120"
    />
    {% else %}
    <img
        class="brand-logo brand__logo--dark"
        src="/assets/getviamsg-logo-white-t-icon-mono.png"
        alt="GetViaMsg"
        width="400"
        height="120"
    />
    <img
        class="brand-logo brand__logo--light"
        src="/assets/getviamsg-logo-dark-t-icon-mono.png"
        alt=""
        aria-hidden="true"
        width="400"
        height="120"
    />
    {% endif %}
</a>
{% endmacro %}
