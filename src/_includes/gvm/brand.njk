{#
  Brand lockup. Uses the real logotype instead of the words "GetViaMsg" — a
  wordmark set in text always drifts from the brand.

  Two flavours:
    - plain wordmark (SVG)      — the site bar and the payment surfaces;
    - "GetViaMsg by WDFT"       — the site footer, where there is room for the
                                  full lockup. `gvmBrand({ lockup: true })`.

  Every flavour ships a dark-theme and a light-theme file; the swap reuses the
  same classes as the site bar (see assets/theme.css).
#}
{% macro gvmBrand(opts) %}
{% set o = opts or {} %}
<a class="gvm-brand {{ o.classes or '' }}" href="https://getviamsg.com/" rel="noopener">
    {% if o.lockup %}
    <img
        class="brand-logo brand-logo--lockup brand__logo--dark"
        src="/assets/getviamsg-logo-white-t-wdft.png"
        alt="GetViaMsg by WDFT"
        width="400"
        height="120"
    />
    <img
        class="brand-logo brand-logo--lockup brand__logo--light"
        src="/assets/getviamsg-logo-dark-t-logo-wdft.png"
        alt=""
        aria-hidden="true"
        width="400"
        height="120"
    />
    {% else %}
    <img
        class="brand-logo brand__logo--dark"
        src="/assets/gvm-logo-dark.svg"
        alt="GetViaMsg"
        width="249"
        height="71"
    />
    <img
        class="brand-logo brand__logo--light"
        src="/assets/gvm-logo-light.svg"
        alt=""
        aria-hidden="true"
        width="249"
        height="71"
    />
    {% endif %}
</a>
{% endmacro %}
