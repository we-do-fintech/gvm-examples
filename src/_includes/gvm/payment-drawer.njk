{% from "gvm/brand.njk" import gvmBrand %}

{% macro paymentDrawer(opts) %}
{% set t = opts.t %}
<template data-gvm-template="payment" data-gvm-template-inject-to="body">


    <dialog
        open
        class="gvm-payment-drawer-overlay"
        aria-label="{{ t.payment.drawerAria }}"
    >
        <div class="gvm-payment-drawer">
            <span class="gvm-payment-drawer__handle" aria-hidden="true"></span>

            <button
                type="button"
                class="gvm-payment-drawer__close"
                data-gvm-bind-cancel
                aria-label="{{ t.payment.cancel }}"
            >
                <span aria-hidden="true">×</span>
            </button>

            <header class="gvm-payment-drawer__header">

                <h2 class="gvm-payment-drawer__title">{{ t.payment.drawerTitle }}</h2>

                <p class="gvm-payment-drawer__subtitle">{{ t.payment.drawerSubtitle }} <span class="gvm-payment-drawer__qr-hint">{{ t.payment.drawerQrHint }}</span></p>
            </header>

            <section class="gvm-payment-drawer__body">
                <div class="gvm-payment-drawer__price">
                    <span class="gvm-payment-drawer__price-label">{{ t.payment.priceLabel }}</span>

                    <strong class="gvm-payment-drawer__price-value">
                        <span data-gvm-bind-price></span>
                        <span data-gvm-bind-currency></span>
                    </strong>
                </div>

                <div
                    class="gvm-payment-drawer__qr-gate gvm-terms-blocked"
                    data-gvm-terms-container
                >
                    <div
                        data-gvm-bind-qr
                        class="gvm-payment-drawer__qr"
                    >
                        <span aria-busy="true"></span>
                    </div>

                    <div class="gvm-payment-drawer__qr-cover">{{ t.payment.qrHint }}</div>
                </div>

                <p class="gvm-payment-drawer__status">
                    <span
                        data-gvm-bind-status
                        data-gvm-bind-status-consent="{{ t.payment.statusConsent }}"
                        data-gvm-bind-status-initializing="{{ t.payment.statusInitializing }}"
                        data-gvm-bind-status-waiting="{{ t.payment.statusWaiting }}"
                        data-gvm-bind-status-duplicated="{{ t.payment.statusDuplicated }}"
                        data-gvm-bind-status-resolved="{{ t.payment.statusResolved }}"
                        data-gvm-bind-status-rejected="{{ t.payment.statusRejected }}"
                    ></span>

                    <span class="gvm-payment-drawer__time">
                        (
                        <span data-gvm-bind-time-remaining>
                            03:00
                        </span>
                        )
                    </span>
                </p>

                <details class="gvm-payment-drawer__how">
                    <summary>{{ t.payment.howTitle }}</summary>
                    <ol>
                        {% for step in t.payment.howSteps %}
                        <li>{{ step }}</li>
                        {% endfor %}
                    </ol>
                </details>

                <p class="gvm-payment-drawer__info">
                    {{ t.consent.infoBefore }}
                    <strong><span data-gvm-bind-price></span>&nbsp;<span data-gvm-bind-currency></span></strong>
                    {{ t.consent.infoAfter }}
                    <a href="{{ opts.termsUrl }}" target="_blank" rel="noopener">{{ t.consent.terms }}</a>.
                </p>

                <label class="gvm-payment-drawer__terms">
                    <input
                        type="checkbox"
                        data-gvm-accept-terms=".gvm-payment-drawer__qr-gate, [data-gvm-bind-send-sms]"
                        data-gvm-accept-terms-version="{{ opts.termsVersion }}"
                        data-gvm-accept-terms-label="{{ t.payment.consentLabel }}"
                    />
                    <span>{{ t.consent.legal }}</span>
                </label>

                <div class="gvm-payment-drawer__actions">
                    <button
                        type="button"
                        class="gvm-payment-drawer__send"
                        data-gvm-bind-send-sms
                    >
                        {{ t.payment.sendSms }}</button>


                </div>
            </section>

            <footer class="gvm-payment-drawer__footer">
                {{ gvmBrand() }}
            </footer>
        </div>
    </dialog>
</template>
{% endmacro %}
