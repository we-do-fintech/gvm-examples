{#
  Sticky side-rail paywall placement (archive: templates/sticky-right.html).

  A compact card docked to the right edge of the viewport, vertically centred,
  following the reader as they scroll. gvm.js injects it into `<body>`; the
  fixed positioning lives in assets/paywalls.css. On screens narrower than
  860px it docks to the bottom-right corner instead, so it never covers the
  text column on phones.

    {% from "gvm/paywall-sticky-right.njk" import paywallStickyRight %}
    {{ paywallStickyRight({ t: i18n[lang], termsUrl: site.termsUrl }) }}

  Differs from the bottom bar: it is a narrow card on the side, not a strip.
  Keyboard/a11y: reachable, no focus trap, keeps clear of the skip link and the
  payment drawer. No consent checkbox — that lives in the payment dialog.
#}
{% from "gvm/consent.njk" import consentInfo %}

{% macro paywallStickyRight(opts) %}
{% set t = opts.t %}
<template
    data-gvm-template="paywall"
    data-gvm-template-inject-to="{{ opts.injectTo or 'body' }}"
>
    <aside
        class="paywall-card paywall-sticky-right"
        role="complementary"
        aria-label="{{ t.paywall.ariaLabel }}"
    >
        <p class="paywall-lead">{{ t.paywall.lead }}</p>
        <p class="paywall-meta">
            <span>{{ t.paywall.meta }}</span>
            <span data-gvm-bind-reading-time></span> {{ t.paywall.minutes }}
        </p>
        {{ consentInfo({ t: t, termsUrl: opts.termsUrl, classes: "consent-info--compact" }) }}
        <button type="button" class="btn btn--accent paywall-cta" data-gvm-bind-pay>
            {{ t.paywall.unlock }}
            <span data-gvm-bind-price></span>
            <span data-gvm-bind-currency></span>
        </button>
    </aside>
</template>
{% endmacro %}
