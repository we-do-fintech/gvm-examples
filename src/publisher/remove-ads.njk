---
lang: pl
title: Bez reklam
description: Jednodniowy dostęp bez reklam po mikropłatności.
crumb: Wydawcy · Bez reklam
altUrl: /en/publisher/remove-ads/
gvm: true
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-drawer.njk" import paymentDrawer %}
{% set article = catalog[lang].article %}

{% block content %}
<div class="container">
    <div class="page-head">
        <h1>Bez reklam</h1>
        <p class="lead">
            Ten sam artykuł, ale z reklamami. Opłać dzień bez reklam, a
            wszystkie sloty znikną na 24 godziny.
        </p>
    </div>

    <div class="ad ad--leaderboard" role="complementary" aria-label="Reklama">
        Miejsce reklamowe · leaderboard
    </div>

    <article class="article">
        <header class="article-head">
            <p class="kicker">Wydawcy · artykuł</p>
            <h1 lang="{{ article.contentLang }}">{{ article.title }}</h1>
            <p class="byline">{{ article.minutes }} min czytania</p>
        </header>

        <div class="article-body" lang="{{ article.contentLang }}">
            {{ article.html | safe }}
        </div>
    </article>

    <div class="ad ad--inline" role="complementary" aria-label="Reklama">
        Miejsce reklamowe · in-article
    </div>

    <div class="adbar">
        <span>Reklama · sticky bottom</span>
        <button
            type="button"
            class="btn btn--accent"
            data-gvm-reference="noads-day"
            data-gvm-price="2.00"
            data-gvm-template-name="payment"
            data-gvm-metadata-title="Dzień bez reklam"
            data-gvm-category="ad_free"
            data-gvm-http-redirect-to="/publisher/remove-ads/?noads=1"
        >
            Dzień bez reklam za 2,00 zł
        </button>
    </div>
</div>

{{ paymentDrawer({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{% endblock %}

{% block scripts %}
<script>
    (function () {
        var KEY = "gvm_ads_free_until";
        var params = new URLSearchParams(window.location.search);
        if (params.get("noads") === "1" && (params.get("gvm-status") || params.get("gvm-reference"))) {
            localStorage.setItem(KEY, String(Date.now() + 24 * 60 * 60 * 1000));
            params.delete("noads");
            params.delete("gvm-status");
            params.delete("gvm-commitment-id");
            params.delete("gvm-reference");
            params.delete("gvm-tenant");
            params.delete("gvm-signature");
            var q = params.toString();
            history.replaceState(null, "", window.location.pathname + (q ? "?" + q : ""));
        }
        var until = Number(localStorage.getItem(KEY) || 0);
        if (until > Date.now()) document.documentElement.classList.add("ads-free");
    })();
</script>
{% endblock %}
