---
lang: pl
title: Odblokowanie artykułu
description: Bezpłatny początek artykułu i mikropłatność za resztę.
crumb: Wydawcy · Odblokowanie artykułu
altUrl: /en/publisher/unlock-article/
gvm: true
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-drawer.njk" import paymentDrawer %}
{% from "gvm/paywall-inline.njk" import paywallInline %}
{% set article = catalog[lang].article %}

{% extends "layouts/base.njk" %}
{% from "gvm/payment-drawer.njk" import paymentDrawer %}
{% from "gvm/paywall-inline.njk" import paywallInline %}
{% set article = catalog[lang].article %}

{% block content %}
<div class="container">
    <article class="article">
        <header class="article-head">
            <p class="kicker">Wydawcy · artykuł</p>
            <h1 lang="{{ article.contentLang }}">{{ article.title }}</h1>
            <p class="byline">{{ article.minutes }} min czytania</p>
        </header>

        <div
            id="article"
            class="article-body wait-for-script"
            lang="{{ article.contentLang }}"
            data-gvm-reference="artykul-{{ lang }}"
            data-gvm-price="1.99"
            data-gvm-template-name="payment"
            data-gvm-hide-template-name="paywall"
            data-gvm-hide-strategy="hide"
            data-gvm-hide-words="{{ article.previewWords }}"
            data-gvm-metadata-title="{{ article.title }}"
            data-gvm-category="article"
        >
            {{ article.html | safe }}
        </div>

        
    </article>
</div>

{{ paymentDrawer({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{{ paywallInline({ t: i18n[lang], termsUrl: site.termsUrl }) }}
{% endblock %}
