---
lang: pl
title: Plik muzyczny
description: Pojedyncze utwory do pobrania po mikropłatności.
crumb: E-commerce cyfrowy · Plik muzyczny
altUrl: /en/digital-ecommerce/download-music-file/
gvm: true
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-dialog.njk" import paymentDialog %}
{% from "gvm/download-trigger.njk" import downloadTrigger %}

{% block content %}
<div class="container">
    <div class="page-head">
        <h1>Plik muzyczny</h1>
    </div>

    <ul class="track-list">
        {% for track in catalog[lang].music %}
        <li class="track">
            <div>
                <p class="track__name">{{ track.title | capitalize }}</p>
                <p class="track__meta">{{ track.seconds | duration }} · {{ track.bytes | filesize }}</p>
            </div>
            {{ downloadTrigger({
                reference: track.id,
                price: "0.99",
                href: track.href,
                title: track.title,
                category: "music_file",
                label: "Pobierz za 0,99 zł"
            }) }}
        </li>
        {% endfor %}
    </ul>
</div>

{{ paymentDialog({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{% endblock %}
