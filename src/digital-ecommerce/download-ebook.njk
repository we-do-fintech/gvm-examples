---
lang: pl
title: E-book
description: Pobranie e-booka po mikropłatności.
crumb: E-commerce cyfrowy · E-book
altUrl: /en/digital-ecommerce/download-ebook/
gvm: true
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-dialog.njk" import paymentDialog %}
{% from "gvm/download-trigger.njk" import downloadTrigger %}

{% block content %}
<div class="container">
    <div class="page-head">
        <h1>E-book</h1>
    </div>

    <div class="media-grid">
        <figure class="media-card">
            <div class="media-card__body">
                <h2>{{ catalog[lang].ebook.title }}</h2>
                <p class="file-meta">
                    {{ catalog[lang].ebook.ext | upper }} · {{ catalog[lang].ebook.bytes | filesize }}
                </p>
                {{ downloadTrigger({
                    reference: "ebook",
                    price: "4.99",
                    href: catalog[lang].ebook.href,
                    title: "E-book",
                    category: "ebook",
                    label: "Pobierz za 4,99 zł"
                }) }}
            </div>
        </figure>
    </div>
</div>

{{ paymentDialog({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{% endblock %}
