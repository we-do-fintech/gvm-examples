---
# Rendered only by `npm run og:image` (OG_BUILD=1); the permalink gate lives in
# og-image.11tydata.js, so a normal build never writes these pages.
pagination:
  data: og.cards
  size: 1
  alias: card
---
<!doctype html>
<html lang="{{ card.lang }}">
    <head>
        <meta charset="utf-8" />
        <meta name="robots" content="noindex" />
        <title>OG · {{ card.key }} · {{ card.lang }}</title>
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html,
            body {
                width: 1200px;
                height: 630px;
                overflow: hidden;
            }

            body {
                /* System stack: the card must render identically offline, with
                   no webfont fetch to wait for. */
                font-family:
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto,
                    "Helvetica Neue", Arial, sans-serif;
                background: #232526;
                color: #ffffff;
            }

            .card {
                position: relative;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                width: 1200px;
                height: 630px;
                padding: 64px 72px 56px;
                background:
                    radial-gradient(
                        90% 70% at 100% 0%,
                        rgba(255, 186, 0, 0.16) 0%,
                        transparent 58%
                    ),
                    radial-gradient(
                        70% 60% at 0% 100%,
                        rgba(255, 186, 0, 0.07) 0%,
                        transparent 60%
                    ),
                    #232526;
            }

            .logo {
                width: 168px;
                height: auto;
            }

            .eyebrow {
                margin-top: 40px;
                color: #ffba00;
                font-size: 19px;
                font-weight: 700;
                letter-spacing: 0.16em;
                text-transform: uppercase;
            }

            .title {
                margin-top: 16px;
                max-width: 1000px;
                font-size: 62px;
                font-weight: 700;
                line-height: 1.08;
                letter-spacing: -0.02em;
            }

            .accent {
                color: #ffba00;
            }

            .subtitle {
                margin-top: 22px;
                max-width: 880px;
                color: #c9ccce;
                font-size: 25px;
                line-height: 1.45;
            }

            .foot {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding-top: 22px;
                border-top: 1px solid #3c3f40;
                color: #909090;
                font-size: 20px;
            }

            .foot strong {
                color: #c9ccce;
                font-weight: 600;
            }
        </style>
    </head>
    <body>
        <div class="card">
            <div>
                <img
                    class="logo"
                    src="../../assets/gvm-logo-dark.svg"
                    alt="GetViaMsg"
                    width="249"
                    height="71"
                />
                <p class="eyebrow">{{ card.eyebrow }}</p>
                <h1 class="title">
                    {{ card.title }}
                    <span class="accent">{{ card.accent }}</span>
                </h1>
                <p class="subtitle">{{ card.subtitle }}</p>
            </div>
            <p class="foot">
                <strong>showcase.getviamsg.com</strong>
                <span>Mikropłatności za pojedyncze treści</span>
            </p>
        </div>
    </body>
</html>
