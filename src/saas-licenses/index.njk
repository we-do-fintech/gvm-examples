---
lang: pl
title: Licencje SaaS
description: Plany aplikacji potwierdzane SMS-em i rozliczane zbiorczo.
altUrl: /en/saas-licenses/
gvm: true
---

{% extends "layouts/base.njk" %}
{% from "gvm/payment-drawer.njk" import paymentDrawer %}

{% block content %}
<div class="container">
    <div class="page-head">
        <h1>Licencje SaaS</h1>
        <p class="lead">Wybierz plan. Potwierdzenie SMS-em, rozliczenie zbiorczo z resztą sesji.</p>
    </div>

    <div id="activation" class="notice" hidden>
        Plan <strong id="plan-name"></strong> aktywny. Kod aktywacyjny: <code id="code"></code>
    </div>

    <div class="card-grid">
        <div class="card">
            <span class="badge">Basic</span>
            <h2>9,99 zł / mies.</h2>
            <p>1 stanowisko, eksport CSV.</p>
            <button type="button" class="btn btn--accent" data-gvm-reference="plan-basic" data-gvm-price="9.99" data-gvm-template-name="payment" data-gvm-metadata-title="Plan Basic" data-gvm-category="plan" data-gvm-http-redirect-to="/saas-licenses/?plan=basic">Wybierz Basic</button>
        </div>
        <div class="card">
            <span class="badge">Plus</span>
            <h2>19,99 zł / mies.</h2>
            <p>3 stanowiska, eksport CSV i PDF.</p>
            <button type="button" class="btn btn--accent" data-gvm-reference="plan-plus" data-gvm-price="19.99" data-gvm-template-name="payment" data-gvm-metadata-title="Plan Plus" data-gvm-category="plan" data-gvm-http-redirect-to="/saas-licenses/?plan=plus">Wybierz Plus</button>
        </div>
        <div class="card">
            <span class="badge">Pro</span>
            <h2>29,99 zł / mies.</h2>
            <p>10 stanowisk, API i priorytet.</p>
            <button type="button" class="btn btn--accent" data-gvm-reference="plan-pro" data-gvm-price="29.99" data-gvm-template-name="payment" data-gvm-metadata-title="Plan Pro" data-gvm-category="plan" data-gvm-http-redirect-to="/saas-licenses/?plan=pro">Wybierz Pro</button>
        </div>
    </div>
</div>

{{ paymentDrawer({ t: i18n[lang], termsUrl: site.termsUrl, termsVersion: site.termsVersion }) }}
{% endblock %}

{% block scripts %}
<script>
    (function () {
        var params = new URLSearchParams(window.location.search);
        var plan = params.get("plan");
        if (!plan) return;
        if (!params.get("gvm-status") && !params.get("gvm-reference")) return;
        var box = document.getElementById("activation");
        document.getElementById("plan-name").textContent = plan.toUpperCase();
        document.getElementById("code").textContent =
            "GVM-" + plan.toUpperCase() + "-" + (1000 + Math.floor(Math.random() * 9000));
        box.hidden = false;
    })();
</script>
{% endblock %}
